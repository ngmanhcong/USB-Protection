;
; UsbProtection.inf
; Development/test minifilter installation file for Windows 10/11 x64.
;

;cho windows biet cach cai dat driver cua minh nhu the nao

[Version]
Signature="$WINDOWS NT$" ; thong tin nhan dang driver
Class=ActivityMonitor ; nhom driver, o day la nhom ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2} ; ma dinh danh
Provider=%ManufacturerName% ; ten nha cung cap driver
DriverVer=09/04/2026,1.0.0.0
CatalogFile=UsbProtection.cat ; file .cat - file luu chu ky va tinh toan ven cua driver
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12 ; thu muc dich mac dinh
UsbProtection.DriverFiles=12 ; thu muc chua cac file driver

[DefaultInstall.NTamd64]
OptionDesc=%ServiceDescription%	; mo ta lua chon cai dat
CopyFiles=UsbProtection.DriverFiles ; copy cac file trong section

[DefaultInstall.NTamd64.Services]
AddService=%ServiceName%,,UsbProtection.ServiceInstall ; them service vao he thong

[DefaultUninstall.NTamd64]
LegacyUninstall=1
DelFiles=UsbProtection.DriverFiles

[DefaultUninstall.NTamd64.Services]
DelService=%ServiceName%,0x200

[UsbProtection.DriverFiles]
UsbProtectionDriver.sys

[UsbProtection.ServiceInstall]
DisplayName=%ServiceDisplayName%
Description=%ServiceDescription%
ServiceBinary=%12%\UsbProtectionDriver.sys
Dependencies=FltMgr
ServiceType=2
StartType=3
ErrorControl=1
LoadOrderGroup="FSFilter Activity Monitor"
AddReg=UsbProtection.AddRegistry

[UsbProtection.AddRegistry]
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Parameters\Instances\%InstanceName%","Altitude",0x00000000,%Altitude%
HKR,"Parameters\Instances\%InstanceName%","Flags",0x00010001,0x0

[SourceDisksFiles]
UsbProtectionDriver.sys=1

[SourceDisksNames]
1=%DiskName%,,,

[Strings]
ManufacturerName="USB Protection PoC"
ServiceName="UsbProtection"
ServiceDisplayName="UsbProtection Minifilter"
ServiceDescription="Blocks write/create operations targeting USB removable storage volumes."
DefaultInstance="UsbProtection Instance"
InstanceName="UsbProtection Instance"
; DEVELOPMENT/TEST placeholder. Production minifilters need an altitude assigned by Microsoft.
Altitude="370030"
DiskName="UsbProtection Installation Disk"
